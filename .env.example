# TrustedNetworx CRM — Environment Variables
# Copy this file to .env and fill in your values.

# JWT signing secret (change this in production!)
JWT_SECRET=change-me-to-a-random-string

# Server port (for local development only)
PORT=3001

# Supabase PostgreSQL — Transaction pooler (for serverless/Netlify Functions)
# Format: postgresql://postgres.<REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase PostgreSQL — Direct connection (for migrations and seeding)
# Format: postgresql://postgres:<PASSWORD>@db.<REF>.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
